<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PrescriptionRefill.Api\PrescriptionRefill.Api.csproj" />
    <ProjectReference Include="..\..\src\PrescriptionRefill.Infrastructure\PrescriptionRefill.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each test class creates its own SQL Server database. Running every class at once on a
         20-thread machine timed out CREATE DATABASE and the 1 s paging budget on a local
         instance, so classes run 4 at a time (spec 005 T040). -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
